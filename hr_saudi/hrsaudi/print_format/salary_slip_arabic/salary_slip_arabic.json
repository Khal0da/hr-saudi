 "font_size": 14,
 "html": "<div style=\"text-align: center; margin-bottom: 20px;\">\n<h2>قسيمة راتب</h2>\n<p><strong>الشركة:</strong> {{ doc.company }}</p>\n<p><strong>الشهر:</strong> {{ doc.posting_date }}</p>\n</div>\n\n<hr>\n\n<table style=\"width: 100%; margin-bottom: 20px;\">\n<tr>\n<td><strong>اسم الموظف:</strong> {{ doc.employee_name }}</td>\n<td><strong>رقم الموظف:</strong> {{ doc.employee }}</td>\n</tr>\n<tr>\n<td><strong>القسم:</strong> {{ doc.department }}</td>\n<td><strong>الفرع:</strong> {{ doc.branch }}</td>\n</tr>\n<tr>\n<td><strong>تاريخ الالتحاق:</strong> {{ doc.date_of_joining }}</td>\n<td><strong>طريقة الدفع:</strong> {{ doc.mode_of_payment }}</td>\n</tr>\n</table>\n\n<hr>\n\n<h3>الاستحقاقات</h3>\n<table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\">\n<thead>\n<tr style=\"background-color: #f0f0f0;\">\n<th style=\"border: 1px solid #ddd; padding: 8px; text-align: right;\">البند</th>\n<th style=\"border: 1px solid #ddd; padding: 8px; text-align: right;\">المبلغ</th>\n</tr>\n</thead>\n<tbody>\n{% for earning in doc.earnings %}\n<tr>\n<td style=\"border: 1px solid #ddd; padding: 8px; text-align: right;\">{{ earning.salary_component }}</td>\n<td style=\"border: 1px solid #ddd; padding: 8px; text-align: right;\">{{ earning.amount }}</td>\n</tr>\n{% endfor %}\n<tr style=\"background-color: #e8f5e9;\">\n<td style=\"border: 1px solid #ddd; padding: 8px; text-align: right;\"><strong>إجمالي الاستحقاقات</strong></td>\n<td style=\"border: 1px solid #ddd; padding: 8px; text-align: right;\"><strong>{{ doc.gross_pay }}</strong></td>\n</tr>\n</tbody>\n</table>\n\n<h3>الاستقطاعات</h3>\n<table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\">\n<thead>\n<tr style=\"background-color: #f0f0f0;\">\n<th style=\"border: 1px solid #ddd; padding: 8px; text-align: right;\">البند</th>\n<th style=\"border: 1px solid #ddd; padding: 8px; text-align: right;\">المبلغ</th>\n</tr>\n</thead>\n<tbody>\n{% for deduction in doc.deductions %}\n<tr>\n<td style=\"border: 1px solid #ddd; padding: 8px; text-align: right;\">{{ deduction.salary_component }}</td>\n<td style=\"border: 1px solid #ddd; padding: 8px; text-align: right;\">{{ deduction.amount }}</td>\n</tr>\n{% endfor %}\n<tr style=\"background-color: #ffebee;\">\n<td style=\"border: 1px solid #ddd; padding: 8px; text-align: right;\"><strong>إجمالي الاستقطاعات</strong></td>\n<td style=\"border: 1px solid #ddd; padding: 8px; text-align: right;\"><strong>{{ doc.total_deduction }}</strong></td>\n</tr>\n</tbody>\n</table>\n\n<hr>\n\n<div style=\"text-align: center; font-size: 18px; margin: 20px 0;\">\n<strong>صافي الراتب: {{ doc.net_pay }}</strong>\n</div>\n\n<br><br>\n\n<table style=\"width: 100%;\">\n<tr>\n<td style=\"width: 50%; text-align: center;\">توقيع الموظف</td>\n<td style=\"width: 50%; text-align: center;\">توقيع الإدارة</td>\n</tr>\n<tr>\n<td style=\"width: 50%; height: 50px;\">_________________</td>\n<td style=\"width: 50%; height: 50px;\">_________________</td>\n</tr>\n</table>",
